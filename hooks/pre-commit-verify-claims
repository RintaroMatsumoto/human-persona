#!/usr/bin/env python3
"""Pre-commit hook: Block commits that add unverified numerical claims to papers.

Install:
    Copy or symlink to .git/hooks/pre-commit
    Or add to your pre-commit config.

What it does:
    1. Checks if any paper files (docs/*.md) are being committed
    2. Looks at the diff for new lines containing numbers
    3. For each number, checks if there's a <!-- run:ID --> on the same line
    4. If unverified numbers are found, blocks the commit

This prevents the exact failure mode we discovered:
    AI writes "Behavioral Coherence: 0.912" without any backing data,
    and the number gets committed without anyone noticing.
"""

from __future__ import annotations

import json
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent
DB_PATH = PROJECT_ROOT / "experiments" / "registry.sqlite"
GIT_EXE = r"C:\Program Files\Git\mingw64\bin\git.exe"

# Regex for numerical claims that need verification
CLAIM_PATTERN = re.compile(
    r"(?:(?:score|alignment|coherence|accuracy|rate|delta|mean|ci|"
    r"improvement|acceptance|diversity|correlation|strength|gratitude|"
    r"p[_-]?value|n\s*=|cohen)"
    r"[^0-9]*)"
    r"(-?\d+[.,]?\d*(?:\.\d+)?%?)",
    re.IGNORECASE,
)

# Regex for run reference comments
RUN_REF_PATTERN = re.compile(r"<!--\s*run:\S+\s*-->")

# Lines to skip
SKIP_PATTERNS = [
    r"^#+\s",           # Headers
    r"^\s*$",           # Empty lines
    r"^---",            # Horizontal rules
    r"^```",            # Code blocks
]


def get_staged_paper_diffs() -> list[tuple[str, str]]:
    """Get added lines in staged paper files."""
    diffs = []
    try:
        result = subprocess.run(
            [GIT_EXE, "diff", "--cached", "--name-only"],
            cwd=str(PROJECT_ROOT),
            capture_output=True, text=True,
        )
        staged_files = result.stdout.strip().split("\n")

        for f in staged_files:
            if not f.strip():
                continue
            if not (f.startswith("docs/") and f.endswith(".md")):
                continue

            result = subprocess.run(
                [GIT_EXE, "diff", "--cached", "-U0", f],
                cwd=str(PROJECT_ROOT),
                capture_output=True, text=True,
            )
            for line in result.stdout.split("\n"):
                if line.startswith("+") and not line.startswith("+++"):
                    diffs.append((f, line[1:]))

    except Exception as e:
        print(f"Warning: Could not read git diff: {e}", file=sys.stderr)

    return diffs


def check_claims(diffs: list[tuple[str, str]]) -> list[str]:
    """Check if numerical claims have run references."""
    violations = []

    for filepath, line in diffs:
        if any(re.match(pat, line) for pat in SKIP_PATTERNS):
            continue

        claims = CLAIM_PATTERN.findall(line)
        if not claims:
            continue

        if RUN_REF_PATTERN.search(line):
            continue

        violations.append(
            f"  {filepath}: \"{line.strip()}\"\n"
            f"    -> Contains numerical claim(s): {claims}\n"
            f"    -> Add <!-- run:RUN_ID --> to verify"
        )

    return violations


def check_run_ids_exist(diffs: list[tuple[str, str]]) -> list[str]:
    """Verify that referenced run IDs exist in the database."""
    violations = []

    if not DB_PATH.exists():
        return violations

    db = sqlite3.connect(str(DB_PATH))
    all_run_ids = set()

    for _, line in diffs:
        for m in re.finditer(r"<!--\s*run:(\S+)\s*-->", line):
            all_run_ids.add(m.group(1))

    for run_id in all_run_ids:
        row = db.execute(
            "SELECT exit_code FROM runs WHERE run_id = ?", (run_id,)
        ).fetchone()
        if row is None:
            violations.append(
                f"  run:{run_id} not found in experiments/registry.sqlite"
            )
        elif row[0] != 0:
            violations.append(
                f"  run:{run_id} had non-zero exit code ({row[0]})"
            )

    db.close()
    return violations


def main() -> int:
    diffs = get_staged_paper_diffs()

    if not diffs:
        return 0

    print("Verifying paper data claims...")

    claim_violations = check_claims(diffs)
    ref_violations = check_run_ids_exist(diffs)

    if claim_violations:
        print("\n[BLOCKED] Unverified numerical claims detected:\n")
        for v in claim_violations:
            print(v)
        print(
            "\nTo fix: Run the experiment through experiments/runner.py,\n"
            "then add <!-- run:RUN_ID --> next to the claim.\n"
        )

    if ref_violations:
        print("\n[BLOCKED] Invalid run references:\n")
        for v in ref_violations:
            print(v)

    if claim_violations or ref_violations:
        print(
            "\nTo bypass (NOT RECOMMENDED): git commit --no-verify\n"
            "To list registered runs: python -m experiments.runner --list\n"
        )
        return 1

    print("  All claims verified.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
